      }
    },
    "Opens a small window from any app, so a thought can be written down without leaving what you are doing. Pick a combination your launcher does not already use.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet aus jedem Programm ein kleines Fenster, damit ein Gedanke notiert werden kann, ohne die Arbeit zu verlassen. Wähle eine Kombination, die dein Launcher nicht schon belegt."
          }
        }
      }
    },
    "People": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen"
          }
        }
      }
    },
    "People appear here on their own, as soon as their machine writes something into a shared folder. There is nobody to invite.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
