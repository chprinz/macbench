    "Could not look for the other Macs in %@: %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen Macs in %@ lassen sich nicht finden: %@"
          }
        }
      }
    },
    "Could not read part of %@'s log in %@: %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Protokolls von %@ in %@ ist nicht lesbar: %@"
          }
        }
      }
    },
    "Could not tell which Mac this change came from. The name is filled in if that Mac's log turns up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von welchem Rechner diese Änderung kam, war nicht feststellbar. Der Name wird nachgetragen, sobald dessen Protokoll eintrifft."
          }
        }
      }
    },
    "Delete": {
