    "%@ — you both saved it at the same time. Open the folder and keep the version you want.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — ihr habt gleichzeitig gespeichert. Öffne den Ordner und behalte die Fassung, die du willst."
          }
        }
      }
    },
