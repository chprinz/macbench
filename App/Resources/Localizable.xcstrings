    "Admin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisation"
          }
        }
      }
    },
    "All": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle"
          }
        }
      }
    },
    "All entries and all changes as one Markdown file. The history should be readable without this app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einträge und alle Änderungen als eine Markdown-Datei. Der Verlauf soll auch ohne diese App lesbar sein."
          }
        }
      }
    },
    "Amber": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bernstein"
          }
        }
      }
    },
    "An archived file leaves the tree, the file lists and search. Nothing is deleted: what was written about it is kept, and this setting is yours alone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Datei verschwindet aus dem Baum, den Dateilisten und der Suche. Gelöscht wird nichts: Was zu ihr geschrieben wurde, bleibt, und diese Einstellung gilt nur für dich."
          }
        }
      }
    },
    "Anyone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Egal wer"
          }
        }
      }
    },
    "Archive": {
      "extractionState": "manual",
      "localizations": {
        "de": {
