            "state": "translated",
            "value": "Mitteilungen"
          }
        }
      }
    },
    "Notifies only for a message addressed to you: a task assigned to you, or a reply to an entry of yours. File changes never notify.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilung gibt es nur bei einer Nachricht an dich: eine Aufgabe mit dir als Zuständige, oder eine Antwort auf deinen Eintrag. Dateiänderungen nie."
          }
        }
      }
    },
